{
  "openapi": "3.1.0",
  "info": {
    "title": "Police Storage Interoperability API",
    "description": "Servicio de almacenamiento interoperable desacoplado y seguro para los sistemas de la Policía (Sistema de Correspondencia y Sistema de Manejo de Oficiales). Incluye aislamiento estricto multi-inquilino, streaming binario y URLs firmadas temporales HMAC para frontend.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8000",
      "description": "Servidor Local / Intranet"
    }
  ],
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "tags": ["Autenticación"],
        "summary": "Iniciar sesión y obtener Bearer Token",
        "description": "Autentica uno de los sistemas preconfigurados (sistema1 o sistema2) y retorna un token Sanctum para autorizar las solicitudes posteriores.",
        "operationId": "login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["username", "password"],
                "properties": {
                  "username": {
                    "type": "string",
                    "example": "sistema1",
                    "description": "Nombre de usuario del sistema (sistema1 o sistema2)"
                  },
                  "password": {
                    "type": "string",
                    "format": "password",
                    "example": "Correspondencia2026!",
                    "description": "Contraseña del sistema"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Autenticación exitosa",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "success" },
                    "message": { "type": "string", "example": "Autenticación exitosa" },
                    "data": {
                      "type": "object",
                      "properties": {
                        "token": { "type": "string", "example": "1|qW89uXpZ12345..." },
                        "token_type": { "type": "string", "example": "Bearer" },
                        "system": {
                          "type": "object",
                          "properties": {
                            "id": { "type": "integer", "example": 1 },
                            "name": { "type": "string", "example": "Sistema de Correspondencia" },
                            "username": { "type": "string", "example": "sistema1" },
                            "system_code": { "type": "string", "example": "sistema1" }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Credenciales inválidas"
          },
          "422": {
            "description": "Error de validación de campos requeridos"
          }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "tags": ["Autenticación"],
        "summary": "Obtener datos del sistema autenticado",
        "operationId": "getAuthenticatedSystem",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Datos del sistema autenticado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "success" },
                    "data": {
                      "type": "object",
                      "properties": {
                        "id": { "type": "integer", "example": 1 },
                        "name": { "type": "string", "example": "Sistema de Correspondencia" },
                        "username": { "type": "string", "example": "sistema1" },
                        "system_code": { "type": "string", "example": "sistema1" }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": { "description": "No autenticado" }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": ["Autenticación"],
        "summary": "Revocar Token de Acceso",
        "operationId": "logout",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Token revocado correctamente",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "success" },
                    "message": { "type": "string", "example": "Token revocado correctamente." }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/files": {
      "get": {
        "tags": ["Archivos"],
        "summary": "Listar archivos con filtros y paginación",
        "description": "Retorna la lista de archivos pertenecientes exclusivamente al sistema autenticado. Permite paginación y filtros por término de búsqueda, extensión y estado activo/inactivo.",
        "operationId": "listFiles",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "required": false,
            "description": "Término de búsqueda parcial sobre el nombre original del archivo (ej. 'informe', 'patrullaje').",
            "schema": { "type": "string", "example": "informe" }
          },
          {
            "name": "extension",
            "in": "query",
            "required": false,
            "description": "Filtrar por extensión del archivo sin punto (ej. 'pdf', 'docx', 'jpg', 'png', 'xlsx').",
            "schema": { "type": "string", "example": "pdf" }
          },
          {
            "name": "is_active",
            "in": "query",
            "required": false,
            "description": "Filtrar por estado activo (true) o inactivo (false).",
            "schema": { "type": "boolean", "example": true }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Número de página solicitada (por defecto: 1).",
            "schema": { "type": "integer", "default": 1, "example": 1 }
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "description": "Cantidad de registros por página (por defecto: 15).",
            "schema": { "type": "integer", "default": 15, "example": 15 }
          }
        ],
        "responses": {
          "200": {
            "description": "Listado paginado de archivos",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "success" },
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/StoredFileResource" }
                    },
                    "meta": {
                      "type": "object",
                      "properties": {
                        "current_page": { "type": "integer", "example": 1 },
                        "last_page": { "type": "integer", "example": 3 },
                        "per_page": { "type": "integer", "example": 15 },
                        "total": { "type": "integer", "example": 42 }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Archivos"],
        "summary": "Cargar nuevo archivo (Multipart)",
        "description": "Sube un archivo de cualquier extensión (.docx, .xls, .pdf, .jpg, .png, etc.) hasta el límite configurado (50 MB). Calcula checksum SHA-256 y genera URLs firmadas temporales.",
        "operationId": "uploadFile",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["file"],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "Archivo binario a subir."
                  },
                  "metadata": {
                    "type": "object",
                    "description": "Objeto JSON o array de metadatos adicionales del sistema origen.",
                    "example": { "departamento": "Investigaciones", "caso": "EXP-2026-004" }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Archivo cargado con éxito",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "success" },
                    "message": { "type": "string", "example": "Archivo cargado correctamente." },
                    "data": { "$ref": "#/components/schemas/StoredFileResource" }
                  }
                }
              }
            }
          },
          "422": { "description": "Error de validación (archivo faltante o excede tamaño)" }
        }
      }
    },
    "/api/v1/files/{uuid}": {
      "get": {
        "tags": ["Archivos"],
        "summary": "Consultar metadatos y URLs de un archivo",
        "operationId": "getFileDetails",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "uuid",
            "in": "path",
            "required": true,
            "description": "UUID único del archivo",
            "schema": { "type": "string", "format": "uuid", "example": "4c98f821-399a-4c28-9d62-7937000e3ef8" }
          }
        ],
        "responses": {
          "200": {
            "description": "Metadatos del archivo",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "success" },
                    "data": { "$ref": "#/components/schemas/StoredFileResource" }
                  }
                }
              }
            }
          },
          "404": { "description": "Archivo no encontrado o no pertenece a este sistema" }
        }
      },
      "delete": {
        "tags": ["Archivos"],
        "summary": "Eliminar físicamente un archivo",
        "description": "Elimina el archivo del almacenamiento en disco y borra el registro de la base de datos.",
        "operationId": "deleteFile",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "uuid",
            "in": "path",
            "required": true,
            "description": "UUID único del archivo",
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Archivo eliminado físicamente",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "success" },
                    "message": { "type": "string", "example": "Archivo eliminado físicamente de forma exitosa." },
                    "data": {
                      "type": "object",
                      "properties": {
                        "uuid": { "type": "string", "format": "uuid" },
                        "deleted": { "type": "boolean", "example": true }
                      }
                    }
                  }
                }
              }
            }
          },
          "404": { "description": "Archivo no encontrado o no pertenece a este sistema" }
        }
      }
    },
    "/api/v1/files/{uuid}/view": {
      "get": {
        "tags": ["Archivos"],
        "summary": "Streaming binario autenticado para visualización (inline)",
        "operationId": "viewFileAuthenticated",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "uuid",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Flujo binario del archivo (Content-Disposition: inline)",
            "content": {
              "application/octet-stream": { "schema": { "type": "string", "format": "binary" } },
              "application/pdf": { "schema": { "type": "string", "format": "binary" } },
              "image/jpeg": { "schema": { "type": "string", "format": "binary" } },
              "image/png": { "schema": { "type": "string", "format": "binary" } }
            }
          },
          "403": { "description": "El archivo se encuentra inactivo" },
          "404": { "description": "Archivo no encontrado o no pertenece a este sistema" }
        }
      }
    },
    "/api/v1/files/{uuid}/download": {
      "get": {
        "tags": ["Archivos"],
        "summary": "Streaming binario autenticado para descarga (attachment)",
        "operationId": "downloadFileAuthenticated",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "uuid",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Descarga de archivo forzada (Content-Disposition: attachment)",
            "content": {
              "application/octet-stream": { "schema": { "type": "string", "format": "binary" } }
            }
          },
          "403": { "description": "El archivo se encuentra inactivo" },
          "404": { "description": "Archivo no encontrado o no pertenece a este sistema" }
        }
      }
    },
    "/api/v1/files/{uuid}/status": {
      "patch": {
        "tags": ["Archivos"],
        "summary": "Modificar estado (activo/inactivo)",
        "operationId": "updateFileStatus",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "uuid",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["is_active"],
                "properties": {
                  "is_active": { "type": "boolean", "example": false, "description": "Estado activo (true) o inactivo (false)" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Estado actualizado correctamente",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "success" },
                    "message": { "type": "string", "example": "Estado del archivo actualizado correctamente." },
                    "data": { "$ref": "#/components/schemas/StoredFileResource" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/signed/files/{uuid}/view": {
      "get": {
        "tags": ["URLs Firmadas (Frontend)"],
        "summary": "Previsualizar archivo mediante URL firmada HMAC",
        "description": "Permite a los navegadores cliente visualizar el archivo en etiquetas <img> o <iframe> sin requerir Bearer Token. Valida la firma HMAC criptográfica y tiempo de expiración.",
        "operationId": "viewSignedFile",
        "parameters": [
          { "name": "uuid", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "name": "expires", "in": "query", "required": true, "schema": { "type": "integer" } },
          { "name": "signature", "in": "query", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Flujo binario para el navegador (inline)" },
          "403": { "description": "Firma inválida o URL expirada" },
          "404": { "description": "Archivo físico no encontrado" }
        }
      }
    },
    "/api/signed/files/{uuid}/download": {
      "get": {
        "tags": ["URLs Firmadas (Frontend)"],
        "summary": "Descargar archivo mediante URL firmada HMAC",
        "description": "Permite descargar directamente el archivo desde el navegador sin cabecera de autorización.",
        "operationId": "downloadSignedFile",
        "parameters": [
          { "name": "uuid", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "name": "expires", "in": "query", "required": true, "schema": { "type": "integer" } },
          { "name": "signature", "in": "query", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Descarga de archivo forzada (attachment)" },
          "403": { "description": "Firma inválida o URL expirada" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Sanctum Token"
      }
    },
    "schemas": {
      "StoredFileResource": {
        "type": "object",
        "properties": {
          "uuid": { "type": "string", "format": "uuid", "example": "7a355651-7ae1-4876-b9dc-3221971fa84c" },
          "original_name": { "type": "string", "example": "informe_patrullaje.pdf" },
          "mime_type": { "type": "string", "example": "application/pdf" },
          "extension": { "type": "string", "example": "pdf" },
          "size_bytes": { "type": "integer", "example": 1048576 },
          "size_human": { "type": "string", "example": "1 MB" },
          "is_active": { "type": "boolean", "example": true },
          "checksum_sha256": { "type": "string", "example": "4b227777d4dd1fc61c6f884f48641d02b4d121d3fd328cb08b5531fcacdabf8a" },
          "metadata": {
            "type": "object",
            "nullable": true,
            "example": { "departamento": "Investigaciones", "caso": "EXP-2026-004" }
          },
          "urls": {
            "type": "object",
            "properties": {
              "direct_view": { "type": "string", "format": "uri", "example": "http://localhost:8000/api/v1/files/7a355651.../view" },
              "direct_download": { "type": "string", "format": "uri", "example": "http://localhost:8000/api/v1/files/7a355651.../download" },
              "signed_view": { "type": "string", "format": "uri", "example": "http://localhost:8000/api/signed/files/7a355651.../view?expires=...&signature=..." },
              "signed_download": { "type": "string", "format": "uri", "example": "http://localhost:8000/api/signed/files/7a355651.../download?expires=...&signature=..." },
              "signed_expires_at": { "type": "string", "format": "date-time", "example": "2026-09-20T17:45:00Z" }
            }
          },
          "created_at": { "type": "string", "format": "date-time", "example": "2026-09-20T17:15:00Z" },
          "updated_at": { "type": "string", "format": "date-time", "example": "2026-09-20T17:15:00Z" }
        }
      }
    }
  }
}
